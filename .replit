entrypoint = "README.md"
modules = ["nodejs-22", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["javascript_database:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 8081

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
EXPO_PUBLIC_DOMAIN = "bookflowx.cerolauto.store"
API_DOMAIN = "bookflowx.cerolauto.store"
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS = "appl_LqjVbACDADybafbTUXlheXxxhkF"
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID = "goog_test_GWhXYzGjxDAjjsjqebFufZExVDz"
